VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_MAPBOX_STYLE_URI=your_mapbox_style_uri_here
VITE_API_URL=your_backend_api_url_here
VITE_CASHFREE_APP_ID=your_cashfree_app_id_here

# Health Check Configuration (for keeping backend alive on free-tier hosting)
# Set to 'true' to enable health checks in development
VITE_ENABLE_HEALTH_CHECK=false
# Health check interval in milliseconds (default: 300000 = 5 minutes)
# Minimum: 60000 (1 minute) to avoid excessive requests
VITE_HEALTH_CHECK_INTERVAL=300000
