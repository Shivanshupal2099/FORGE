# ============================================
# SERVER CONFIGURATION
# ============================================
# Port on which the server will run
PORT=5000

# Environment: development, production, or test
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB connection string (Atlas or local)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?options
MONGODB_URI=your_mongodb_connection_string_here

# Alternative MongoDB URL (fallback if MONGODB_URI is not set)
MONGO_URL=your_mongodb_connection_string_here

# ============================================
# AUTHENTICATION & JWT
# ============================================
# Secret key for signing JWT tokens (backend-issued)
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Supabase JWT secret for verifying Supabase session tokens
# Only needed if using Supabase authentication
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,http://localhost:5174,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://your-frontend-domain.com
